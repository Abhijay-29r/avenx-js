import { AvenxGuard } from 'avenx-core/runtime';

/**
 * AuthGuard handles route protection by verifying user authentication status.
 * Unauthorized users are redirected to the login page.
 */
export default class AuthGuard extends AvenxGuard {
    /**
     * Determines whether the requested route can be activated.
     * Inspects user authentication state and redirects unauthorized users to the login page.
     *
     * @param {Object} to - The target route object (contains hash, page, params).
     * @param {Object} from - The current route object (contains hash, page, params).
     * @returns {boolean|string|Object|Promise<boolean|string|Object>}
     */
    canActivate(to, from) {
        // Inspect user authentication state (e.g., checking token in localStorage, cookie, or auth store)
        const isAuthenticated = Boolean(localStorage.getItem('authToken'));

        if (!isAuthenticated) {
            // Redirect unauthorized users to the login page
            return '#/login';
        }

        // Allow access to protected route
        return true;
    }
}
